---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Indra Juliansyah Putra — Data Scientist & ML Engineer",
  description = "Portfolio of Indra Juliansyah Putra — Computer Science graduate, TensorFlow Developer Certified, specializing in data analysis, machine learning, and AI.",
  ogImage = "/og-image.png",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://indranalytics.netlify.app");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Indra Juliansyah Putra",
  url: "https://indranalytics.netlify.app",
  jobTitle: "Data Scientist & Machine Learning Engineer",
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universitas Sriwijaya",
  },
  knowsAbout: [
    "Machine Learning",
    "Data Science",
    "TensorFlow",
    "Computer Vision",
    "Python",
    "Deep Learning",
  ],
  sameAs: [
    "https://github.com/indraJuliansyahPutra",
    "https://www.linkedin.com/in/indra-juliansyah-putra/",
    "https://medium.com/@mrindrajuliansyahputra10",
    "https://www.kaggle.com/indrajuliansyahputra",
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Palembang",
    addressCountry: "ID",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Indra Juliansyah Putra" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="IndrAnalytics" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Fonts (preconnect for performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Roboto+Mono:wght@400;500&family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background text-text antialiased">
    <!-- Skip to content (accessibility) -->
    <a
      href="#about"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[999] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-black"
    >
      Skip to main content
    </a>

    <slot />
  </body>
</html>
