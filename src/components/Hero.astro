---
import { personal, typewriterTexts } from "../data/personal";
---

<section
  id="home"
  class="relative flex h-screen items-center justify-center bg-cover bg-center"
  style="background-image: url('/images/background.jpg');"
>
  <div
    class="flex h-full w-full flex-col items-center justify-center bg-black/50 text-center"
  >
    <h1
      class="font-heading text-4xl font-bold text-primary [text-shadow:0_0_15px_var(--color-primary)] md:text-6xl"
    >
      HELLO WORLD
    </h1>
    <h2
      id="typewriter"
      class="mt-4 h-10 font-mono text-xl text-accent md:text-3xl"
      data-texts={JSON.stringify(typewriterTexts)}
    >
    </h2>
    <p class="mt-3 text-sm tracking-widest text-text-muted md:text-base">
      {personal.subtitle}
    </p>
  </div>
</section>

<script>
  const el = document.getElementById("typewriter");
  if (el) {
    const texts: string[] = JSON.parse(el.dataset.texts || "[]");
    let count = 0;
    let index = 0;

    function type() {
      if (count === texts.length) count = 0;
      const current = texts[count];
      const letter = current.slice(0, ++index);
      el!.textContent = letter;

      if (index === current.length) {
        setTimeout(() => {
          index = 0;
          count++;
          setTimeout(type, 500);
        }, 2000);
      } else {
        setTimeout(type, 100);
      }
    }
    type();
  }
</script>

<style>
  #typewriter::after {
    content: "|";
    animation: blink 0.7s infinite;
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
