---
import { certificates } from "../data/certificates";
---

<section id="certificates" class="px-6 py-20 md:px-12">
  <h2
    class="mb-12 text-center font-heading text-3xl font-bold text-primary md:text-4xl"
  >
    My Certificates
  </h2>

  <div class="mx-auto max-w-md overflow-hidden">
    <div
      id="cert-track"
      class="flex transition-transform duration-500 ease-in-out"
    >
      {
        certificates.map((cert) => (
          <div class="w-full shrink-0 px-2">
            <div class="overflow-hidden rounded-xl border border-primary/20 bg-surface">
              <div class="flex h-48 items-center justify-center bg-black/30">
                <img
                  src={cert.image}
                  alt={cert.title}
                  class="h-full w-full object-contain p-2"
                  loading="lazy"
                />
              </div>
              <div class="p-5">
                <h3 class="font-heading text-base font-bold text-primary">
                  {cert.title}
                </h3>
                <p class="mt-1 text-sm text-text-muted">
                  Issuer: {cert.issuer}
                </p>
                <p class="text-sm text-text-muted">Issued: {cert.issued}</p>
                <p class="text-sm text-text-muted">ID: {cert.credentialId}</p>
                <a
                  href={cert.verifyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-block rounded border border-primary px-3 py-1 text-xs text-primary transition-shadow hover:shadow-[0_0_10px_var(--color-primary)]"
                >
                  View Certificate
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Dots -->
    <div id="cert-dots" class="mt-6 flex justify-center gap-2">
      {
        certificates.map((_, i) => (
          <button
            class={`cert-dot h-2.5 w-2.5 rounded-full transition-colors ${i === 0 ? "bg-primary" : "bg-text-muted/30"}`}
            data-index={i}
            aria-label={`Go to certificate ${i + 1}`}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  const track = document.getElementById("cert-track");
  const dots = document.querySelectorAll(".cert-dot");
  const total = dots.length;
  let current = 0;
  let interval: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    current = index;
    if (track) track.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => {
      d.classList.toggle("bg-primary", i === current);
      d.classList.toggle("bg-text-muted/30", i !== current);
    });
  }

  function next() {
    goTo((current + 1) % total);
  }

  function startAutoSlide() {
    interval = setInterval(next, 3000);
  }

  function resetAutoSlide() {
    clearInterval(interval);
    startAutoSlide();
  }

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      goTo(Number((dot as HTMLElement).dataset.index));
      resetAutoSlide();
    });
  });

  // Touch/swipe support
  let touchStartX = 0;
  track?.addEventListener("touchstart", (e) => {
    touchStartX = (e as TouchEvent).touches[0].clientX;
  });
  track?.addEventListener("touchend", (e) => {
    const diff = touchStartX - (e as TouchEvent).changedTouches[0].clientX;
    if (Math.abs(diff) > 50) {
      if (diff > 0) goTo((current + 1) % total);
      else goTo((current - 1 + total) % total);
      resetAutoSlide();
    }
  });

  startAutoSlide();
</script>
