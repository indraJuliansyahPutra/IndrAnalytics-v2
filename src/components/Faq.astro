---
import { faqItems } from "../data/faq";
---

<section id="faq" class="px-6 py-20 md:px-12">
  <h2
    class="mb-12 text-center font-heading text-3xl font-bold text-primary md:text-4xl"
  >
    Frequently Asked Questions
  </h2>

  <div class="mx-auto max-w-2xl space-y-4">
    {
      faqItems.map((item) => (
        <div class="faq-item overflow-hidden rounded-xl border border-primary/20 bg-surface">
          <button
            class="faq-toggle flex w-full items-center justify-between p-5 text-left"
            aria-expanded="false"
          >
            <span class="font-heading text-sm font-bold text-primary">
              {item.question}
            </span>
            <i class="fas fa-chevron-down text-primary transition-transform duration-300" />
          </button>
          <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300">
            <p class="px-5 pb-5 text-sm leading-relaxed text-text-muted">
              {item.answer}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll(".faq-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".faq-item")!;
      const answer = item.querySelector(".faq-answer") as HTMLElement;
      const icon = btn.querySelector("i")!;
      const isOpen = btn.getAttribute("aria-expanded") === "true";

      btn.setAttribute("aria-expanded", String(!isOpen));
      icon.classList.toggle("rotate-180");

      if (!isOpen) {
        answer.style.maxHeight = answer.scrollHeight + "px";
      } else {
        answer.style.maxHeight = "0";
      }
    });
  });
</script>
