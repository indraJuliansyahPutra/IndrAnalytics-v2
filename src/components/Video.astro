---
import { video } from "../data/video";
---

<section id="watch-video" class="px-6 py-20 md:px-12">
  <h2
    class="mb-12 text-center font-heading text-3xl font-bold text-primary md:text-4xl"
  >
    {video.title}
  </h2>

  <div class="mx-auto max-w-3xl">
    <div class="relative w-full overflow-hidden rounded-xl pt-[56.25%]">
      <iframe
        class="absolute inset-0 h-full w-full border-0"
        src={`https://www.youtube.com/embed/${video.youtubeId}?si=4ERzVCYVUYspvU2l`}
        title="YouTube video player"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
        loading="lazy"></iframe>
    </div>
  </div>
</section>
