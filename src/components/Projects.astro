---
import { projects } from "../data/projects";
---

<section id="projects" class="px-6 py-20 md:px-12">
  <h2
    class="mb-12 text-center font-heading text-3xl font-bold text-primary md:text-4xl"
  >
    My Projects
  </h2>

  <div
    id="projects-grid"
    class="mx-auto grid max-w-5xl gap-8 sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      projects.map((project) => (
        <div
          class={`project-card group cursor-pointer overflow-hidden rounded-xl border border-primary/20 bg-surface transition-all hover:shadow-[0_0_20px_var(--color-primary)] ${!project.visible ? "hidden" : ""}`}
          data-project={project.id}
        >
          <div class="flex h-48 items-center justify-center overflow-hidden bg-black/30">
            <img
              src={project.thumbnail}
              alt={project.title}
              class="h-full w-full object-contain p-2 transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="p-5">
            <h3 class="font-heading text-lg font-bold text-primary">
              {project.title}
            </h3>
            <p class="mt-1 text-sm text-accent">{project.category}</p>
            <button
              class="preview-btn mt-4 rounded border border-primary px-4 py-2 text-sm text-primary transition-shadow hover:shadow-[0_0_10px_var(--color-primary)]"
              data-project={project.id}
            >
              Preview Project
            </button>
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-10 text-center">
    <button
      id="load-more"
      class="rounded-md border-2 border-primary px-8 py-3 font-semibold text-primary transition-shadow hover:shadow-[0_0_15px_var(--color-primary)]"
    >
      Load More
    </button>
  </div>
</section>

<!-- Project Modal -->
<div
  id="project-modal"
  class="fixed inset-0 z-[200] hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
>
  <div
    class="relative max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-2xl border border-primary/30 bg-surface-light p-6"
  >
    <button
      id="modal-close"
      class="absolute right-4 top-4 text-2xl text-text-muted transition-colors hover:text-primary"
      aria-label="Close modal"
    >
      &times;
    </button>

    <div class="relative flex items-center justify-center">
      <button
        id="modal-prev"
        class="absolute left-0 z-10 rounded-full bg-black/50 px-3 py-1 text-2xl text-primary transition-colors hover:bg-black/80"
        aria-label="Previous image"
      >
        &#10094;
      </button>
      <img
        id="modal-image"
        src=""
        alt="Project preview"
        class="max-h-[50vh] rounded-lg object-contain"
      />
      <button
        id="modal-next"
        class="absolute right-0 z-10 rounded-full bg-black/50 px-3 py-1 text-2xl text-primary transition-colors hover:bg-black/80"
        aria-label="Next image"
      >
        &#10095;
      </button>
    </div>

    <p id="modal-description" class="mt-6 leading-relaxed text-text-muted"></p>

    <div class="mt-6 flex gap-4">
      <a
        id="modal-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-primary px-6 py-2 font-semibold text-black transition-shadow hover:shadow-[0_0_15px_var(--color-primary)]"
      >
        View Project
      </a>
      <button
        id="modal-close-btn"
        class="rounded-md border border-primary px-6 py-2 text-primary transition-shadow hover:shadow-[0_0_10px_var(--color-primary)]"
      >
        Close
      </button>
    </div>
  </div>
</div>

<script define:vars={{ projectsData: projects }}>
  // Load more toggle
  const loadMoreBtn = document.getElementById("load-more");
  const cards = document.querySelectorAll(".project-card");
  let expanded = false;

  function updateVisibility() {
    const isMobile = window.innerWidth <= 768;
    const limit = isMobile ? 1 : 3;
    cards.forEach((card, i) => {
      if (expanded) {
        card.classList.remove("hidden");
      } else {
        card.classList.toggle("hidden", i >= limit);
      }
    });
    if (loadMoreBtn) {
      loadMoreBtn.textContent = expanded ? "Show Less" : "Load More";
    }
  }

  loadMoreBtn?.addEventListener("click", () => {
    expanded = !expanded;
    updateVisibility();
  });
  window.addEventListener("resize", () => {
    if (!expanded) updateVisibility();
  });
  updateVisibility();

  // Modal
  const modal = document.getElementById("project-modal");
  const modalImage = document.getElementById("modal-image");
  const modalDesc = document.getElementById("modal-description");
  const modalLink = document.getElementById("modal-link");
  const modalClose = document.getElementById("modal-close");
  const modalCloseBtn = document.getElementById("modal-close-btn");
  const modalPrev = document.getElementById("modal-prev");
  const modalNext = document.getElementById("modal-next");

  let currentImages = [];
  let currentIndex = 0;

  function openModal(projectId) {
    const project = projectsData.find((p) => p.id === projectId);
    if (!project) return;
    currentImages = project.images;
    currentIndex = 0;
    modalImage.src = currentImages[0].src;
    modalImage.alt = currentImages[0].alt;
    modalDesc.textContent = project.description;
    modalLink.href = project.link;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.querySelectorAll(".preview-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      openModal(btn.dataset.project);
    });
  });

  modalClose?.addEventListener("click", closeModal);
  modalCloseBtn?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  modalPrev?.addEventListener("click", () => {
    currentIndex =
      (currentIndex - 1 + currentImages.length) % currentImages.length;
    modalImage.src = currentImages[currentIndex].src;
    modalImage.alt = currentImages[currentIndex].alt;
  });

  modalNext?.addEventListener("click", () => {
    currentIndex = (currentIndex + 1) % currentImages.length;
    modalImage.src = currentImages[currentIndex].src;
    modalImage.alt = currentImages[currentIndex].alt;
  });

  document.addEventListener("keydown", (e) => {
    if (modal?.classList.contains("hidden")) return;
    if (e.key === "Escape") closeModal();
    if (e.key === "ArrowLeft") modalPrev?.click();
    if (e.key === "ArrowRight") modalNext?.click();
  });
</script>
