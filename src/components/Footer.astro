---
const year = new Date().getFullYear();
---

<footer class="border-t border-primary/10 py-6 text-center">
  <p class="text-sm text-text-muted">
    &copy; {year} Indra Juliansyah Putra. All Rights Reserved.
  </p>
</footer>

<!-- Back to Top -->
<button
  id="back-to-top"
  class="fixed bottom-6 right-6 z-50 hidden h-12 w-12 items-center justify-center rounded-full bg-primary text-xl text-black shadow-lg transition-all hover:shadow-[0_0_15px_var(--color-primary)]"
  aria-label="Back to top"
>
  <i class="fas fa-chevron-up"></i>
</button>

<script>
  const btn = document.getElementById("back-to-top");
  window.addEventListener("scroll", () => {
    if (btn) {
      if (window.scrollY > 300) {
        btn.classList.remove("hidden");
        btn.classList.add("flex");
      } else {
        btn.classList.add("hidden");
        btn.classList.remove("flex");
      }
    }
  });
  btn?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
